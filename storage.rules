rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Trip cover photos (signed-in read, owner write) ────────────────────
    // Note: in-app <img> uses tokenized download URLs which work regardless;
    // requiring auth here just blocks unauthenticated enumeration.
    match /coverPhotos/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Trip photos (shared: any signed-in user can read; only uploader can delete) ──
    match /photos/{userId}/{tripId}/{fileName} {
      // Any signed-in user can read — shared gallery
      allow read: if request.auth != null;
      // Only the uploader can write (upload) to their own folder. Photos are
      // compressed client-side so they stay small; videos are uploaded as they
      // came off the camera, so they get their own (larger) ceiling — kept in
      // step with MAX_VIDEO_BYTES in photo.service.ts.
      allow create: if request.auth != null && request.auth.uid == userId
        && (
          (request.resource.contentType.matches('image/(png|jpeg|jpg|gif|webp|heic|heif)')
            && request.resource.size < 15 * 1024 * 1024)      // 15 MB
          || (request.resource.contentType.matches('video/.*')
            && request.resource.size < 100 * 1024 * 1024)     // 100 MB
        );
      // Only the uploader can delete their own photo
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ── Profile avatars (small, image-only, owner-writable) ─────────────────
    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 512 * 1024        // 512 KB max — compressed client-side
        // Not image/.* : SVG is an image that can carry script.
        && request.resource.contentType.matches('image/(png|jpeg|jpg|gif|webp|heic|heif)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ── Trip documents (25 MB max, signed-in only) ───────────────────────────
    // Travel documents are PDFs, images, and the occasional office file. HTML
    // and SVG are excluded deliberately: Storage serves uploads from its own
    // origin, so an uploaded page would run as live content on a Google domain
    // under a link that looks like it belongs to the app.
    match /documents/{userId}/{tripId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 25 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/(png|jpeg|jpg|gif|webp|heic|heif)')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('text/plain')
          || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*')
          || request.resource.contentType.matches('application/msword')
        );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
